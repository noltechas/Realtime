{
  "expo": {
    "name": "Realtime Karaoke",
    "slug": "realtime-karaoke-mobile",
    "scheme": "realtimekaraoke",
    "version": "1.0.2",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noltechas.karaoke",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan the host's QR code so you can join the session.",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo to show on stage and in the queue.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Karaoke"
      }
    },
    "android": {
      "package": "com.noltechas.realtimekaraoke",
      "adaptiveIcon": {
        "backgroundColor": "#5b1ea8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the host's QR code so you can join the session."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo to show on stage and in the queue.",
          "cameraPermission": "Take a profile photo to show on stage and in the queue."
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#5b1ea8",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98da3795-cb1a-457d-80d7-a662090b1b84"
      }
    },
    "owner": "chasnolte",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/98da3795-cb1a-457d-80d7-a662090b1b84"
    }
  }
}
