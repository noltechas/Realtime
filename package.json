{
  "name": "realtime-karaoke",
  "private": true,
  "version": "1.0.0",
  "description": "Realtime karaoke monorepo: Electron desktop app, React Native iOS companion, shared library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@karaoke/desktop",
    "dev:mobile": "npm run start --workspace=@karaoke/mobile",
    "build": "npm run build --workspace=@karaoke/desktop",
    "start": "npm run start --workspace=@karaoke/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
